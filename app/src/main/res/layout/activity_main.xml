<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/title_main"
            android:textColor="@color/color_text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/image_main"
            android:src="@drawable/chinese_municipalities" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_input"
            android:textColor="@color/color_text_dark"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_municipality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_municipality"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>
</ScrollView>
